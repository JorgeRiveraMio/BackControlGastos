@using System.Globalization
@using ControlGastos.Web.Services
@model ControlGastos.Web.Models.ViewModels.GastosIndexViewModel
@{
    ViewData["Title"] = "Gastos";
    var cultura = CultureInfo.InvariantCulture;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Gastos</h1>
        <p class="text-muted mb-0">Total del mes: <strong>S/ @Model.TotalMes.ToString("N2", cultura)</strong></p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar gasto</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (TempData["Warning"] is string warning)
{
    <div class="alert alert-warning" role="alert">@warning</div>
}

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-sm-4 col-md-3">
            <label for="mes" class="form-label">Mes</label>
            <select id="mes" name="mes" class="form-select">
                @for (var mes = 1; mes <= 12; mes++)
                {
                    <option value="@mes" selected="@(mes == Model.Mes)">@CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(mes)</option>
                }
            </select>
        </div>
        <div class="col-sm-4 col-md-3">
            <label for="anio" class="form-label">Año</label>
            <input id="anio" name="anio" type="number" min="2000" max="2100" value="@Model.Anio" class="form-control" />
        </div>
        <div class="col-sm-4 col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Fecha</th><th>Comercio</th><th>Categoría</th><th>Medio de pago</th>
                <th>Descripción</th><th class="text-end">Monto</th><th>Estado</th><th>Comprobante</th><th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Gastos.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted py-4">No hay gastos para el período seleccionado.</td></tr>
        }
        @foreach (var gasto in Model.Gastos)
        {
            <tr>
                <td>@FechaLimaHelper.ConvertirDesdeUtc(gasto.FechaGasto).ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(gasto.NombreComercio ?? "—")</td>
                <td>@gasto.NombreCategoria</td>
                <td>@(gasto.NombreMedioPago ?? "—")</td>
                <td class="text-break">@(gasto.Descripcion ?? "—")</td>
                <td class="text-end text-nowrap">S/ @gasto.Monto.ToString("N2", cultura)</td>
                <td><span class="badge @(gasto.CodEstado == "ACTIVO" ? "text-bg-success" : "text-bg-secondary")">@gasto.CodEstado</span></td>
                <td>
                    @if (gasto.TieneComprobante)
                    {
                        <button type="button" data-id-gasto="@gasto.IdGasto" class="btn btn-sm btn-outline-primary btn-ver-comprobante">Ver</button>
                        <form asp-action="SubirComprobante" asp-route-id="@gasto.IdGasto" method="post" enctype="multipart/form-data" class="d-flex gap-1 mt-1">
                            @Html.AntiForgeryToken()
                            <input type="file" name="archivo" accept="image/jpeg,image/png,image/webp" class="form-control form-control-sm" required />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Reemplazar</button>
                        </form>
                        <form asp-action="EliminarComprobante" asp-route-id="@gasto.IdGasto" method="post" class="d-inline" onsubmit="return confirm('¿Deseas eliminar este comprobante?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="SubirComprobante" asp-route-id="@gasto.IdGasto" method="post" enctype="multipart/form-data" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="file" name="archivo" accept="image/jpeg,image/png,image/webp" class="form-control form-control-sm" required />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Subir</button>
                        </form>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@gasto.IdGasto" class="btn btn-sm btn-outline-primary">Editar</a>
                    @if (gasto.CodEstado == "ACTIVO")
                    {
                        <form asp-action="Delete" asp-route-id="@gasto.IdGasto" method="post" class="d-inline" onsubmit="return confirm('¿Deseas anular este gasto?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger" type="submit">Anular</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="comprobanteModal" tabindex="-1" aria-labelledby="comprobanteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="comprobanteModalLabel">Comprobante</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p id="comprobanteEstado" class="mb-0">Cargando comprobante...</p>
                <img id="comprobanteImagen" class="img-fluid d-none" alt="Comprobante del gasto" style="max-width: 100%; max-height: 70vh; object-fit: contain;" />
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('comprobanteModal');
        const comprobanteModal = new bootstrap.Modal(modalElement);
        const imagen = document.getElementById('comprobanteImagen');
        const estado = document.getElementById('comprobanteEstado');

        document.querySelectorAll('.btn-ver-comprobante').forEach(boton => {
            boton.addEventListener('click', async () => {
                estado.textContent = 'Cargando comprobante...';
                estado.classList.remove('d-none');
                imagen.classList.add('d-none');
                imagen.removeAttribute('src');
                comprobanteModal.show();
                try {
                    const response = await fetch(`/Gastos/${boton.dataset.idGasto}/Comprobante/Url`, { credentials: 'same-origin' });
                    const data = await response.json();
                    if (!response.ok || !data.isOk || !data.url) throw new Error('No disponible');
                    imagen.src = data.url;
                    imagen.classList.remove('d-none');
                    estado.classList.add('d-none');
                } catch {
                    estado.textContent = 'No se pudo cargar el comprobante.';
                }
            });
        });

        modalElement.addEventListener('hidden.bs.modal', () => {
            imagen.removeAttribute('src');
            imagen.classList.add('d-none');
            estado.textContent = 'Cargando comprobante...';
            estado.classList.remove('d-none');
        });
    </script>
}
