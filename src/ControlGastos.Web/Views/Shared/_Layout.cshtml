<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Gastos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @if (Context.Session.GetString(ControlGastos.Web.Models.SessionKeys.AccessToken) is not null)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">Control de Gastos</a>
                    <div class="d-flex align-items-center gap-2">
                        <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        <a class="nav-link text-white" asp-controller="Gastos" asp-action="Index">Gastos</a>
                        <a class="nav-link text-white" asp-controller="Perfil" asp-action="Index">Perfil</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            </nav>
        </header>
    }
    <main class="container py-4">
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
