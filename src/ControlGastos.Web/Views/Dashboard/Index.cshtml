@using System.Globalization
@using ControlGastos.Web.Services
@model ControlGastos.Web.Models.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; var cultura = CultureInfo.InvariantCulture; var porcentaje = Model.PorcentajePresupuestoConsumido ?? 0; var estilo = porcentaje >= 100 ? "bg-danger" : porcentaje >= Model.PorcentajeAlerta ? "bg-warning" : "bg-success"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><h1 class="h3 mb-0">Dashboard</h1>
<form method="get" class="d-flex gap-2"><select name="mes" class="form-select">@for(var m=1;m<=12;m++){<option value="@m" selected="@(m == Model.Mes)">@CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option>}</select><input name="anio" type="number" min="2000" max="2100" value="@Model.Anio" class="form-control" /><button class="btn btn-outline-primary">Filtrar</button></form></div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (!Model.PerfilConfigurado) { <div class="alert alert-info d-flex justify-content-between align-items-center">Configura tu ingreso y presupuesto para aprovechar mejor el dashboard.<a asp-controller="Perfil" asp-action="Index" class="btn btn-sm btn-primary">Configurar perfil</a></div> }
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Total gastado</div><div class="fs-4 fw-bold">S/ @Model.TotalGastado.ToString("N2", cultura)</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Ingreso</div><div class="fs-4 fw-bold">@(Model.IngresoMensual.HasValue ? $"S/ {Model.IngresoMensual.Value.ToString("N2", cultura)}" : "Sin configurar")</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Disponible</div><div class="fs-4 fw-bold">@(Model.DisponibleEstimado.HasValue ? $"S/ {Model.DisponibleEstimado.Value.ToString("N2", cultura)}" : "—")</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Promedio por gasto</div><div class="fs-4 fw-bold">S/ @Model.PromedioGasto.ToString("N2", cultura)</div></div></div></div></div>
@if (Model.PresupuestoMensual is not null) { <div class="card mb-4"><div class="card-body"><div class="d-flex justify-content-between"><span>Presupuesto consumido</span><strong>@porcentaje.ToString("N2", cultura)%</strong></div><div class="progress mt-2" role="progressbar"><div class="progress-bar @estilo" style="width: @Math.Min(porcentaje, 100).ToString(cultura)%"></div></div><small class="text-muted">Presupuesto: S/ @Model.PresupuestoMensual.Value.ToString("N2", cultura)</small></div></div> }
@if (Model.PorcentajePresupuestoConsumido >= 100) { <div class="alert alert-danger">Has superado tu presupuesto.</div> }
else if (Model.PorcentajePresupuestoConsumido >= Model.PorcentajeAlerta) { <div class="alert alert-warning">Estás cerca del límite de tu presupuesto.</div> }
<div class="row g-4"><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h5">Gastos por categoría</h2>@if(!Model.GastosPorCategoria.Any()){<p class="text-muted">No hay gastos este mes.</p>}else{<div class="list-group list-group-flush">@foreach(var categoria in Model.GastosPorCategoria){<div class="list-group-item d-flex justify-content-between px-0"><span>@categoria.NombreCategoria <small class="text-muted">(@categoria.Cantidad)</small></span><strong>S/ @categoria.Monto.ToString("N2", cultura)</strong></div>}</div>}</div></div></div>
<div class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h5">Últimos gastos</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Comercio</th><th>Categoría</th><th class="text-end">Monto</th><th>Comp.</th></tr></thead><tbody>@foreach(var gasto in Model.UltimosGastos){<tr><td>@FechaLimaHelper.ConvertirDesdeUtc(gasto.FechaGasto).ToString("dd/MM HH:mm")</td><td>@(gasto.NombreComercio ?? "—")</td><td>@gasto.NombreCategoria</td><td class="text-end">S/ @gasto.Monto.ToString("N2", cultura)</td><td>@(gasto.TieneComprobante ? "Sí" : "No")</td></tr>}</tbody></table></div></div></div></div></div>
