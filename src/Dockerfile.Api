FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY ControlGastos.slnx ./

COPY src/ControlGastos.Api/ControlGastos.Api.csproj src/ControlGastos.Api/
COPY src/ControlGastos.Core/ControlGastos.Core.csproj src/ControlGastos.Core/
COPY src/ControlGastos.Infrastructure/ControlGastos.Infrastructure.csproj src/ControlGastos.Infrastructure/

RUN dotnet restore src/ControlGastos.Api/ControlGastos.Api.csproj

COPY src/ src/

RUN dotnet publish src/ControlGastos.Api/ControlGastos.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://0.0.0.0:10000

EXPOSE 10000

ENTRYPOINT ["dotnet", "ControlGastos.Api.dll"]